# Copy this file to .env before running Docker Compose.

# Host port to publish, and where Flipper's SQLite database lives on disk.
FLIPPER_PORT=19012
FLIPPER_DATA_PATH=./data/flipper

# Container-side HTTP listen address and database file path — rarely need
# to change these.
FLIPPER_LISTEN=:19012
FLIPPER_DB=/app/data/flipper.db

# Used only to create the admin account the very first time Flipper starts
# with no users yet. Change the password before starting the stack; after
# first boot, manage the admin password from the Account page in the UI.
FLIPPER_INITIAL_USERNAME=admin
FLIPPER_INITIAL_PASSWORD=replace-with-a-long-random-app-password

# Version string baked into the image at build time (cosmetic only).
FLIPPER_VERSION=0.01
